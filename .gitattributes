# ============================================================
# G4 Ligand Classifier — .gitattributes (Git LFS tracking)
# ============================================================
# Last updated: 2026-06-19
# Large file patterns are stored via Git LFS instead of regular git
# ============================================================

# --- ML models (binary, large) ---
*.joblib filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text

# --- Large raw data files ---
data/g4ldb/g4ldb_activity_raw.jsonl filter=lfs diff=lfs merge=lfs -text
data/g4ldb/g4ldb_activity.csv filter=lfs diff=lfs merge=lfs -text

# --- Ensure correct line endings for code/scripts ---
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# ============================================================
