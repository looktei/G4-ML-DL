# ============================================================
# G4 Ligand Classifier — .gitignore
# ============================================================
# Last updated: 2026-06-19
# Strategy: Full + LFS tier (track all data + models via LFS)
# ============================================================

# --- Python cache & build ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
condaenv/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- Logs & runtime ---
logs/
*.log
*.pid
*.seed
*.pid.lock

# --- Test artifacts ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
coverage.xml
*.cover

# --- Environment & secrets ---
.env
.env.local
*.env
secrets.yaml
config/local.py

# --- Backup & temp files ---
_backup_*.py
_backup_*.yml
_backup_*.yaml
_embedded_source_virtual/
*.tmp
*.bak
*.orig

# --- OS files ---
Thumbs.db
.DS_Store
desktop.ini

# --- ML/DL specific ---
*.pyc
*.pyd
*.pdb
core.*
*.ckpt.tmp

# NOTE: Large model/data files are tracked via Git LFS (see .gitattributes)
# DO NOT exclude *.joblib, *.pt, *.safetensors, *.jsonl — LFS handles them
# ============================================================
